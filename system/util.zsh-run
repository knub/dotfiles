function swap() { mv $1 $1._tmp; mv $2 $1; mv $1._tmp $2; }

function watchdir() {
	watch ls -lisah $1
}

# find file, ignore gitignored files
function ff() {
	ag --skip-vcs-ignores -l --nocolor --hidden -g "$1"
}
# find file, do not ignore gitignored files
function ffa() {
	ag -a -l --nocolor --hidden -g "$1"
}
function vimopen() {
	vim -p $(ff $1)
}

function filesort() {
	for i in "$@"; do
		# LC_ALL to do simple byte wise sorting
		LC_ALL=C sort -o $i $i
	done;
}

function take() {
  mkdir -p $1
  cd $1
}

setopt interactivecomments

alias sum='awk "{ sum += \$1 } END { print sum }"'

function lsdownloads() {
	ls ~/Downloads
}

# Reset the ath11k wifi driver (QCNFA765) when it wedges after suspend/resume
# and 4-way WPA handshake fails with reason=2.
function wifi-reset() {
	sudo modprobe -r ath11k_pci ath11k && sleep 2 && sudo modprobe ath11k_pci
}
