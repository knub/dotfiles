function swap() { mv $1 $1._tmp; mv $2 $1; mv $1._tmp $2; }

function watchdir() {
	watch ls -lisah $1
}

# find file, ignore gitignored files
function ff() {
	ag --skip-vcs-ignores -l --nocolor --hidden -g "$1"
}
# find file, do not ignore gitignored files
function ffa() {
	ag -a -l --nocolor --hidden -g "$1"
}
function vimopen() {
	vim -p $(ff $1)
}

function filesort() {
	for i in "$@"; do
		# LC_ALL to do simple byte wise sorting
		LC_ALL=C sort -o $i $i
	done;
}

function take() {
  mkdir -p $1
  cd $1
}

setopt interactivecomments

alias sum='awk "{ sum += \$1 } END { print sum }"'

function lsdownloads() {
	ls ~/Downloads
}

# simple_zip <folder>
# Creates <basename>.zip in the current directory from the given folder.
# Resolves the output path before cd'ing, so the zip lands where you ran
# the command, not next to the source.
function simple_zip() {
	if [[ $# -ne 1 ]]; then
		echo "usage: simple_zip <folder>" >&2
		return 2
	fi
	local src="${1%/}"
	local name parent out
	name="$(basename "$src")"
	parent="$(dirname "$src")"
	out="$PWD/${name}.zip"
	[[ -d "$src" ]] || { echo "simple_zip: not a directory: $src" >&2; return 1; }
	[[ -e "$out" ]] && { echo "simple_zip: refusing to overwrite: $out" >&2; return 1; }
	(cd "$parent" && zip -ry "$out" "$name" -x "*/.DS_Store")
}
