# Theme
theme = Builtin Tango Light

# Font
font-size = 20

# Shell
shell-integration = zsh
shell-integration-features = cursor,sudo,path,no-title
bell-features = title,attention

# Scrollback, ~1 GB
scrollback-limit = 1000000000


# Window
window-padding-x = 8
window-padding-y = 8
window-save-state = always

# Clipboard
clipboard-trim-trailing-spaces = true

# Scrolling — tame touchpad (precision) separately from mouse wheel (discrete)
mouse-scroll-multiplier = precision:0.5,discrete:3

# Notifications
desktop-notifications = false

