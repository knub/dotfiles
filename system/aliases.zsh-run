alias re-source="source ~/.zshrc"

# http://stackoverflow.com/questions/5367068/clear-the-ubuntu-bash-screen-for-real
alias cls='printf "\033c"'

alias wcl="wc -l"
alias ls="ls --color=tty -N"
alias lisa="ls -lisahFN"

function cpv() {
	rsync -poghb --backup-dir=/tmp/rsync -e /dev/null --progress --
}

export EDITOR=vim
export PAGER=less

alias markdown_to_format="wl-paste | pandoc -f markdown -t html | wl-copy --type text/html"

# Automatically open files with correct application
alias -s html=$BROWSER
alias -s org=$BROWSER
alias -s php=$EDITOR
alias -s com=$BROWSER
alias -s net=$BROWSER
alias -s gz=tar -xzvf
alias -s bz2=tar -xjvf
alias -s java=$EDITOR
alias -s txt=$EDITOR
alias -s PKGBUILD=$EDITOR
