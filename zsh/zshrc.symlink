export DOTFILES=$HOME/dotfiles
### Antigen
setopt INTERACTIVE_COMMENTS
source $DOTFILES/zsh/antigen/antigen.zsh
antigen use oh-my-zsh
antigen bundle arzzen/calc.plugin.zsh
antigen bundle dirhistory
antigen bundle extract
antigen bundle mvn
antigen bundle vagrant
antigen bundle web-search
antigen apply

# Replace known paths with their variable short form
setopt auto_name_dirs
export DOTFILES=$HOME/dotfiles # reexport DOTFILES, so we get the short name
# Source all my *.zsh-run files
for config_file ($DOTFILES/**/*.zsh-run) source $config_file

# Start autocompletion
# autoload -U compinit
# compinit
#

export HISTSIZE=100000
export SAVEHIST=100000

# The next line updates PATH for the Google Cloud SDK.
if [ -f /opt/google-cloud-sdk/path.zsh.inc ]; then
  source '/opt/google-cloud-sdk/path.zsh.inc'
fi

# The next line enables shell command completion for gcloud.
if [ -f /opt/google-cloud-sdk/completion.zsh.inc ]; then
  source '/opt/google-cloud-sdk/completion.zsh.inc'
fi

# Completely disable the '=' alias:
# Prevents an error with Claude Code: https://www.perplexity.ai/search/in-claude-code-i-m-often-getti-6jW4Mx4gTOG3T6bttcCfCw
unalias '=' 2>/dev/null

unset DIR

# Created by `pipx` on 2025-09-21 13:17:33
export PATH="$PATH:/Users/knub/.local/bin"

export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"  # This loads nvm
[ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"  # This loads nvm bash_completion
