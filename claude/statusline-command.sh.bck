#!/bin/sh
input=$(cat)
cwd=$(echo "$input" | jq -r '.cwd')

# Shorten home directory to ~
dir=$(echo "$cwd" | sed "s|^$HOME|~|")

# Get folder name (last component) for a cleaner look
folder=$(basename "$cwd")

# Git branch
branch=""
if [ -d "$cwd/.git" ] || git -C "$cwd" rev-parse --git-dir >/dev/null 2>&1; then
  branch=$(git -C "$cwd" symbolic-ref --short HEAD 2>/dev/null || git -C "$cwd" rev-parse --short HEAD 2>/dev/null)
fi

if [ -n "$branch" ]; then
  printf "You are in \033[1m%s\033[0m on branch \033[1m%s\033[0m." "$dir" "$branch"
else
  printf "You are in \033[1m%s\033[0m." "$dir"
fi

# Pick an ANSI fg color escape based on two thresholds: yellow when pct >= $2,
# red when pct > $3, else empty. Uses \033[39m to restore default fg so an
# enclosing bold attribute stays intact.
# $1 = integer pct, $2 = yellow threshold, $3 = red threshold
pct_color() {
  if [ "$1" -gt "$3" ]; then
    printf '\033[31m'
  elif [ "$1" -ge "$2" ]; then
    printf '\033[33m'
  fi
}

# Emit a percentage, colored via pct_color.
# $1 = integer pct, $2 = yellow threshold, $3 = red threshold
fmt_pct() {
  color=$(pct_color "$1" "$2" "$3")
  if [ -n "$color" ]; then
    printf '%s%s%%\033[39m' "$color" "$1"
  else
    printf '%s%%' "$1"
  fi
}

# Emit a [██████░░░░]-style progressbar, colored via pct_color.
# $1 = integer pct, $2 = yellow threshold, $3 = red threshold,
# $4 = width (default 10), $5 = max (default 100)
fmt_bar() {
  pct=$1
  yellow=$2
  red=$3
  width=${4:-10}
  max=${5:-100}
  [ "$pct" -lt 0 ] && pct=0
  bar_pct=$pct
  [ "$bar_pct" -gt "$max" ] && bar_pct=$max
  filled=$(( bar_pct * width / max ))
  bar=""
  i=0
  while [ "$i" -lt "$filled" ]; do bar="${bar}█"; i=$((i+1)); done
  while [ "$i" -lt "$width" ]; do bar="${bar}░"; i=$((i+1)); done
  color=$(pct_color "$pct" "$yellow" "$red")
  if [ -n "$color" ]; then
    printf '%s[%s]\033[39m' "$color" "$bar"
  else
    printf '[%s]' "$bar"
  fi
}

# Rate limit usage (only shown when data is available; 7d only shown when > 60%; each value red when > 75%)
five=$(echo "$input" | jq -r '.rate_limits.five_hour.used_percentage // empty')
five_resets=$(echo "$input" | jq -r '.rate_limits.five_hour.resets_at // empty')
week=$(echo "$input" | jq -r '.rate_limits.seven_day.used_percentage // empty')
rate_out=""
if [ -n "$five" ]; then
  five_int=$(printf '%.0f' "$five")
  five_str="5h: $(fmt_bar "$five_int" 60 75) $(fmt_pct "$five_int" 60 75)"
  if [ -n "$five_resets" ]; then
    now=$(date +%s)
    secs_left=$(( five_resets - now ))
    if [ "$secs_left" -gt 0 ]; then
      mins_left=$(( secs_left / 60 ))
      h_part=$(( mins_left / 60 ))
      m_part=$(( mins_left % 60 ))
      if [ "$h_part" -gt 0 ]; then
        resets_str="${h_part}h${m_part}m"
      else
        resets_str="${m_part}m"
      fi
      five_str="$five_str (resets in $resets_str)"
    fi
  fi
  rate_out="$five_str"
fi
if [ -n "$week" ]; then
  week_int=$(printf '%.0f' "$week")
  if [ "$week_int" -ge 60 ]; then
    rate_out="$rate_out 7d: $(fmt_bar "$week_int" 60 75) $(fmt_pct "$week_int" 60 75)"
  fi
fi
[ -n "$rate_out" ] && printf " | Rate limits: \033[1m%s\033[0m" "$rate_out"

# Context window usage (only shown when data is available; red when > 20%)
ctx_used=$(echo "$input" | jq -r '.context_window.used_percentage // empty')
if [ -n "$ctx_used" ]; then
  ctx_int=$(printf '%.0f' "$ctx_used")
  printf " | \033[1mContext: %s %s\033[0m" "$(fmt_bar "$ctx_int" 20 25 10 25)" "$(fmt_pct "$ctx_int" 20 25)"
fi
